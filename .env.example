# Local API (Docker: pude-api on :3001). The browser talks to NEXT_PUBLIC_API_URL,
# the Next.js server talks to INTERNAL_API_URL. Both must be the same API.
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001

# Remote dev API. Switch back once /placement-test is deployed there:
# NEXT_PUBLIC_API_URL=https://borrow-api-dev.bbxst-hub.dev
# INTERNAL_API_URL=https://borrow-api-dev.bbxst-hub.dev
